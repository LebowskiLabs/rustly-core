#!/usr/bin/env ruby

# frozen_string_literal: true

require "bundler/setup"
require "benchmark"
require "benchmark/memory"
require "parallel"

require "dry-struct"
require "dry-types"
require "smart_core/value-object"
require "rustly/core"

module Types
  include Dry::Types(default: :strict)
end

SCHEMA = {
  type: :struct,
  extra: :forbid,
  fields: [
    [:required, :name, :str, {}],
    [:required, :email, :str, { format: :email }],
    [:required, :age, :int, { min: 18 }],
    [:optional, :tags, %i[list str], { min_size: 1, max_size: 5 }]
  ]
}.freeze
TAGS      = Array.new(5) { |i| "tag#{i}".freeze }.freeze
TAG_ARRS  = TAGS.map { |t| [t].freeze }.freeze
OPTIONS = { freeze: :none, store_attributes: false }.freeze

class RustlyUser
  attr_reader :name, :email, :age, :tags
end

module DryModel
  class User < Dry::Struct
    attribute :name, Types::Coercible::String
    attribute :email, Types::Coercible::String.constrained(format: /@/)
    attribute :age, Types::Coercible::Integer.constrained(gteq: 18)
    attribute :tags, Types::Coercible::Array.of(Types::String).optional.default([].freeze)
  end
end

module SmartCoreModel
  class User < SmartCore::ValueObject
    attribute :name, "value.string"
    attribute :email, "value.string"
    attribute :age, "value.integer"
    attribute :tags, "value.array"
  end
end

def build_dataset(size)
  Array.new(size) do |i|
    {
      name: "User-#{i}",
      email: "user#{i}@example.com",
      age: 25 + (i % 10),
      tags: TAG_ARRS[i % 5]
    }
  end
end

def run!
  dataset = build_dataset(100_000)
  compiled_schema = Rustly::Core.compile(SCHEMA, OPTIONS)

  puts "Benchmarking #{dataset.size} records"

  # Memory comparison - Single Threaded
  puts "\n=== Memory Comparison (Single Threaded) ==="
  Benchmark.memory do |x|
    x.report("Dry") do
      dataset.each do |payload|
        DryModel::User.new(payload)
      end
    end

    x.report("SmartCore") do
      dataset.each do |payload|
        SmartCoreModel::User.new(
          payload[:name],
          payload[:email],
          payload[:age],
          payload[:tags]
        )
      end
    end

    x.report("Rust") do
      dataset.each do |payload|
        Rustly::Core.build(compiled_schema, payload, RustlyUser)
      end
    end

    x.compare!
  end

  # Speed comparison - Single Threaded
  puts "\n=== Speed Comparison (Single Threaded) ==="
  Benchmark.bmbm do |x|
    x.report("Rust") do
      dataset.each do |payload|
        Rustly::Core.build(compiled_schema, payload, RustlyUser)
      end
    end

    x.report("Dry") do
      dataset.each do |payload|
        DryModel::User.new(payload)
      end
    end

    x.report("SmartCore") do
      dataset.each do |payload|
        SmartCoreModel::User.new(
          payload[:name],
          payload[:email],
          payload[:age],
          payload[:tags]
        )
      end
    end
  end

  # Speed comparison - Parallel (10 threads)
  puts "\n=== Speed Comparison (10 Threads) ==="
  Benchmark.bmbm do |x|
    x.report("Rust (10 threads, synced)") do
      Parallel.each(dataset, in_threads: 10) do |payload|
        Rustly::Core.build_synced(compiled_schema, payload, RustlyUser)
      end
    end

    x.report("Dry (10 threads)") do
      Parallel.each(dataset, in_threads: 10) do |payload|
        DryModel::User.new(payload)
      end
    end

    x.report("SmartCore (10 threads)") do
      Parallel.each(dataset, in_threads: 10) do |payload|
        SmartCoreModel::User.new(
          payload[:name],
          payload[:email],
          payload[:age],
          payload[:tags]
        )
      end
    end
  end
end

run!
